# syntax=docker/dockerfile:1
#
# x-coach FastAPI backend.
#
# BUILD CONTEXT IS THE REPO ROOT, not backend/ — the app imports `backend.app.*` and
# `src.pose.*` / `src.knowledge.*` by absolute package path and must be launched from the
# repo root (see backend/app/main.py). Build it as:
#
#     docker build -f backend/Dockerfile -t x-coach-backend .
#
# `data/` is deliberately NOT baked in (see .dockerignore): it is gitignored, partly
# multi-gigabyte, and the KG/RAG stores are generated by the pipelines. docker-compose
# bind-mounts ./data to /app/data. Without it the API still serves — analysis and the
# knowledge endpoints just report their stores missing on GET /api/health.

FROM python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# libgl1 + libglib2.0-0 + libsm6/libxext6: MediaPipe pulls in the non-headless
# opencv-contrib-python wheel, which links against libGL even when nothing is drawn.
# ffmpeg gives OpenCV a full decoder set for user-uploaded video (MOV/HEVC from phones).
# curl is used by HEALTHCHECK below.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      libgl1 \
      libglib2.0-0 \
      libsm6 \
      libxext6 \
      ffmpeg \
      curl \
 && rm -rf /var/lib/apt/lists/*

# Dependencies first, in their own layer: they change far less often than the source,
# so an app edit rebuilds in seconds instead of re-resolving the ML stack.
COPY requirements-docker.txt ./
RUN python -m pip install --upgrade pip \
 && python -m pip install -r requirements-docker.txt

COPY backend/ ./backend/
COPY src/ ./src/

# Non-root. data/runtime/ is where LocalObjectStore writes when R2 is unconfigured, so it
# must be writable by the runtime user even when nothing is mounted over /app/data.
RUN useradd --create-home --uid 10001 xcoach \
 && mkdir -p /app/data/runtime/objects \
 && chown -R xcoach:xcoach /app/data
USER xcoach

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
  CMD curl -fsS http://127.0.0.1:8000/api/health || exit 1

# Single worker by default: each analysis is CPU/RAM-heavy and the in-process cap
# (XCOACH_MAX_CONCURRENT_ANALYSES, default 2) is *per worker*, so scale with replicas or
# an explicit --workers only once you have measured the box.
CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
