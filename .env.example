# x-coach backend environment. Copy to `.env` at the repo root (gitignored) and fill in.
# Find these in the Supabase dashboard: Project Settings → API (URL + anon key) and
# Project Settings → API → JWT Settings (JWT secret).

# Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# anon / public key — the backend acts as the user (RLS-enforced), never service_role.
SUPABASE_ANON_KEY=

# JWT secret used to verify access tokens (HS256). Keep this secret.
SUPABASE_JWT_SECRET=

# Optional: cap on concurrent in-process analyses (P0 stop-gap). Defaults to 2.
# XCOACH_MAX_CONCURRENT_ANALYSES=2
