# x-coach backend environment. Copy to `.env` at the repo root (gitignored) and fill in.
# Find these in the Supabase dashboard: Project Settings → API (URL + anon/public key).

# Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# anon / public key — the backend acts as the user (RLS-enforced), never service_role.
# Access tokens are validated via the Supabase Auth API, so no JWT signing secret is needed.
SUPABASE_ANON_KEY=

# Optional: cap on concurrent in-process analyses (P0 stop-gap). Defaults to 2.
# XCOACH_MAX_CONCURRENT_ANALYSES=2

# --- Object storage for user videos (Cloudflare R2, S3-compatible) ---------------------------
# Leave these blank to keep uploads on the local runtime disk (fine for dev / anonymous demo).
# Set all of them to push each signed-in user's video to a PRIVATE R2 bucket and stream it back
# via short-lived presigned URLs — required for a real public deployment (the app container's disk
# is ephemeral). Create an R2 bucket + an API token (Object Read & Write) in the Cloudflare dashboard.
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=x-coach-videos
# Optional: override the derived endpoint (default https://<account>.r2.cloudflarestorage.com).
# R2_ENDPOINT=
# Optional: presigned-URL lifetime in seconds (default 300).
# R2_URL_TTL_S=300

# --- Upload limits & per-user storage quota (public-deployment guardrails) --------------------
# Defaults: 100 MB / 60 s per clip, 30 videos & 1 GB per user. Override to loosen for a bigger deploy.
# XCOACH_MAX_UPLOAD_BYTES=104857600
# XCOACH_MAX_UPLOAD_DURATION_S=60
# XCOACH_USER_VIDEO_QUOTA_COUNT=30
# XCOACH_USER_STORAGE_QUOTA_BYTES=1073741824

# Conversational coaching (LLM chat) — server-side only, never sent to the browser. Leave
# LLM_API_KEY unset to keep /api/chat disabled (503). OpenAI-compatible transport (named LLM_* rather
# than after any one provider): works with OpenRouter (default) or NVIDIA NIM. Provider/switching
# notes: backend/README.md § Conversational coaching.
LLM_API_KEY=
# LLM_MODELS=deepseek/deepseek-v4-flash,xiaomi/mimo-v2.5,minimax/minimax-m3,tencent/hy3-preview
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_FOLLOWUP_MODEL=openai/gpt-oss-120b
