# x-coach backend environment. Copy to `.env` at the repo root (gitignored) and fill in.
# Find these in the Supabase dashboard: Project Settings → API (URL + anon/public key).

# Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# anon / public key — the backend acts as the user (RLS-enforced), never service_role.
# Access tokens are validated via the Supabase Auth API, so no JWT signing secret is needed.
SUPABASE_ANON_KEY=

# Optional: cap on concurrent in-process analyses (P0 stop-gap). Defaults to 2.
# XCOACH_MAX_CONCURRENT_ANALYSES=2

# Conversational coaching (LLM chat) via OpenRouter. Server-side only — never exposed to the
# browser. Leave OPENROUTER_API_KEY unset to keep /api/chat disabled (returns 503).
# Get a key at https://openrouter.ai/keys. Model ids use OpenRouter's "vendor/model" namespace.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL is the model used for the "Server default" choice — set it to ANY OpenRouter
# model when self-hosting and that's what runs (it's never restricted by the curated list). Hosted
# users may additionally pick one of the curated four in Settings (deepseek/deepseek-v4-flash,
# xiaomi/mimo-v2.5, minimax/minimax-m3, tencent/hy3-preview), validated server-side. Defaults to
# deepseek/deepseek-v4-flash. See backend/app/settings.py.
# OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
