# x-coach frontend env. Copy to `frontend/.env` (gitignored) and fill in.
# Vite only exposes vars prefixed with VITE_ to the browser. The anon key is safe to ship —
# row access is governed by Postgres RLS. Leave these unset to run as a public demo (no auth).

# From Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# LINE LIFF app id (LINE Developers console → LINE Login channel → LIFF tab), e.g. 1234567890-Abcdefgh.
# Required for LINE sign-in: BOTH the web (external-browser) and in-app paths use LIFF to get
# a LINE ID token, then exchange it via the backend bridge (POST /api/auth/line). Leave unset
# to disable LINE sign-in entirely. See docs/line-login-liff-setup.md.
VITE_LIFF_ID=
