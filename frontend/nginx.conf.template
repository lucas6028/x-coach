# Serves the built SPA and stands in for Vite's dev proxy: /api -> the backend service,
# so the app keeps using same-origin relative URLs (see frontend/src/api.ts).
#
# This is a TEMPLATE, not a finished config: nginx's entrypoint runs envsubst over
# /etc/nginx/templates/*.template at container start and writes the result to
# /etc/nginx/conf.d/. Only ${BACKEND_ORIGIN} is substituted -- NGINX_ENVSUBST_FILTER in the
# Dockerfile pins the substitution to that one name, so nginx's own runtime variables
# ($host, $uri, $proxy_add_x_forwarded_for, ...) below survive verbatim. Without the filter
# envsubst would blank every one of them and the proxy headers would silently go empty.
#
# BACKEND_ORIGIN defaults to the docker-compose service (http://backend:8000) and is
# overridden in Azure with the backend's internal Container Apps FQDN. See
# docs/azure-deployment.md.

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Video uploads go through this proxy. Analysis input is short phone clips; keep the
    # ceiling generous but finite so a stray upload can't fill the disk.
    client_max_body_size 256m;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    location /api/ {
        # No URI part after the origin, so the request path is passed through unchanged.
        # Resolved once at config load: the Container Apps environment's internal endpoint
        # is a stable address, so there is nothing to re-resolve between backend revisions.
        proxy_pass ${BACKEND_ORIGIN};
        proxy_http_version 1.1;
        # $proxy_host, not $host: the Container Apps internal ingress routes by Host header,
        # so forwarding the browser's hostname makes the environment fail to find the app.
        # Compose does not care either way (uvicorn ignores it), so one setting serves both.
        # The original hostname is preserved on X-Forwarded-Host for anything that wants it.
        proxy_set_header Host              $proxy_host;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # /api/chat streams tokens (SSE). Buffering here would hold the whole reply until
        # the stream closed, which reads as a dead chat box.
        proxy_buffering off;
        proxy_cache off;

        # A cold analysis (MediaPipe + rules + RAG) can run for minutes; the default 60s
        # read timeout would 504 mid-run.
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
        # Raised from the 60s default for the same reason, one step earlier: when the backend
        # runs at minReplicas 0 (see infra/main.parameters.json), this connection is what
        # waits for a replica to be activated and to load the KG and the vector DB. On
        # compose the backend is already up and this never fires.
        proxy_connect_timeout 120s;
    }

    # Vite emits content-hashed filenames under /assets, so they are safe to pin forever.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # index.html must never be cached, or a deploy leaves clients on stale asset hashes.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # SPA fallback: react-router owns every other path.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
